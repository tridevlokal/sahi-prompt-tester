# Google Gemini API key — get from https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# ElevenLabs API key — get from https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Deepgram API key — get from https://console.deepgram.com (free $200 credit on signup)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ElevenLabs base URL — leave at default (global) unless you have a regional residency key.
# Default (global): wss://api.elevenlabs.io
# India residency:  wss://api.in.residency.elevenlabs.io
# EU residency:     wss://api.eu.residency.elevenlabs.io
ELEVENLABS_BASE_URL=wss://api.elevenlabs.io

# ElevenLabs voice IDs (one per language)
# Find a voice ID at https://elevenlabs.io/app/voice-library — copy its ID
VOICE_ID_ENGLISH=PLACEHOLDER_ENGLISH_VOICE_ID
VOICE_ID_TAMIL=PLACEHOLDER_TAMIL_VOICE_ID
VOICE_ID_TELUGU=PLACEHOLDER_TELUGU_VOICE_ID
VOICE_ID_KANNADA=PLACEHOLDER_KANNADA_VOICE_ID

# Server settings (you usually won't need to change these)
HOST=127.0.0.1
PORT=7860

# Smallest.ai TTS API key — https://waves.smallest.ai
SMALLEST_API_KEY=your_smallest_api_key_here

# Groq (Whisper STT) — console.groq.com
GROQ_API_KEY=
